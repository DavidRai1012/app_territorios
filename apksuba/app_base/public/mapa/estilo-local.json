{
  "version": 8,
  "name": "Suba Offline",
  "metadata": {
    "descripcion": "Estilo local minimalista para el mapa sin conexion. Lee las tiles vectoriales del archivo suba.pmtiles (schema OpenMapTiles generado por Tilemaker)."
  },
  "glyphs": "mapa/glyphs/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "pmtiles://mapa/suba.pmtiles",
      "attribution": "© OpenStreetMap"
    }
  },
  "layers": [
    {
      "id": "fondo",
      "type": "background",
      "paint": { "background-color": "#f4f3ee" }
    },
    {
      "id": "areas-verdes",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", "class", "wood", "grass", "park", "scrub"],
      "paint": { "fill-color": "#d6e6c3", "fill-opacity": 0.6 }
    },
    {
      "id": "parques",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": { "fill-color": "#d6e6c3", "fill-opacity": 0.5 }
    },
    {
      "id": "agua",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": { "fill-color": "#a0c8e0" }
    },
    {
      "id": "edificios",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-color": "#e6e1d8",
        "fill-outline-color": "#d2ccc0",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "vias-menores",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "track"],
      "minzoom": 13,
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.5, 18, 4]
      }
    },
    {
      "id": "vias-secundarias",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "secondary", "tertiary"],
      "paint": {
        "line-color": "#fdfcf7",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.8, 18, 8]
      }
    },
    {
      "id": "vias-principales",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "primary", "trunk", "motorway"],
      "paint": {
        "line-color": "#f7d8a0",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1.2, 18, 12]
      }
    },
    {
      "id": "etiquetas-calles",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 13, 10, 18, 15],
        "symbol-placement": "line",
        "symbol-spacing": 350,
        "text-max-angle": 40
      },
      "paint": {
        "text-color": "#5b5b5b",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "etiquetas-lugares",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["in", "class", "suburb", "neighbourhood", "quarter"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 12, 16, 17],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#3b3b3b",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.6
      }
    }
  ]
}
